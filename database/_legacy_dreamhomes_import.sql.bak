INSERT INTO `news` (`id`, `name`, `top_title`, `bottom_title`, `slug`, `photo`, `description`, `division_id`, `district_id`, `area_id`, `user_id`, `writer_id`, `action_date`, `total_visit`, `total_share`, `total_print`, `order`, `show_in_home`, `status`, `meta_title`, `meta_keyword`, `meta_description`, `created_at`, `updated_at`, `deleted_at`) VALUES
(1, 'ড্রিম হোমস ছাত্রদের সাফল্যগাথা', NULL, NULL, 'suePmngHBYVsz8s', 'news/suepmnghbyvsz8s.webp', '<p class=\"ql-align-justify\"><span style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">আলহামদুলিল্লাহ</span></p><p class=\"ql-align-justify\"><span style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">ড্রিম হোমসের শিক্ষার্থীরা প্রতিকূলতাকে পেছনে ফেলে আলোর পথে এগিয়ে চলেছে। এখানে প্রত্যেকটি শিশু শুধু আশ্রয়ই নয়, পায় সঠিক দিকনির্দেশনা, মানসম্মত শিক্ষা এবং আত্মবিশ্বাস গড়ে তোলার সুযোগ। নানা সামাজিক চ্যালেঞ্জ সত্ত্বেও তারা নিজেদের স্বপ্ন ধরে রাখছে এবং প্রতিদিনই নতুন সাফল্যের গল্প লিখছে। কেউ ভালো রেজাল্ট করছে, কেউ আবার বিভিন্ন প্রতিযোগিতায় অংশ নিয়ে প্রতিষ্ঠানকে গর্বিত করছে। প্রযুক্তি, ক্রীড়া, শিল্প-সংস্কৃতি—সব ক্ষেত্রেই তারা নিজেদের দক্ষতা তুলে ধরছে। তাদের অধ্যবসায়, শৃঙ্খলা ও ইতিবাচক মানসিকতা ড্রিম হোমসের পরিবেশকে আরও সমৃদ্ধ করে। এই সাফল্যগুলো শুধু তাদের ব্যক্তিগত অর্জন নয়, বরং পুরো প্রতিষ্ঠানের যত্ন ও ভালোবাসার প্রতিফলন। ড্রিম হোমস বিশ্বাস করে—প্রতিটি শিশুই পারে, যদি তাকে সুযোগ দেওয়া হয়। আর সেই সুযোগই তাদের ভবিষ্যতের দরজা খুলে দিচ্ছে।</span></p><p><br></p>', NULL, NULL, NULL, 4, NULL, '2025-12-07', 9, NULL, NULL, 1, NULL, 1, NULL, NULL, NULL, '2025-12-07 02:06:22', '2026-04-28 11:00:15', NULL),
(2, 'ড্রিম হোমস্ স্পোর্টস অনুষ্ঠিত', NULL, NULL, '1KVW91FLWtG6vh4', 'news/1kvw91flwtg6vh4.webp', '<p><span style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">ড্রিম হোমসে প্রাণবন্ত পরিবেশে অনুষ্ঠিত হয়েছে বার্ষিক স্পোর্টস প্রতিযোগিতা। শিশুদের হাসি, উৎসাহ এবং প্রতিযোগিতার মনোভাব পুরো মাঠে এক বিশেষ উচ্ছ্বাস ছড়িয়ে দিয়েছে। দৌড়, লাফ, বল খেলা সহ নানা ইভেন্টে অংশ নিয়ে তারা দেখিয়েছে নিজেদের দক্ষতা ও দলগত চেতনা। খেলাধুলার মাধ্যমে তাদের শারীরিক সুস্থতা, আত্মবিশ্বাস এবং পারস্পরিক সহযোগিতার মানসিকতা আরও বৃদ্ধি পেয়েছে। এই আয়োজন শুধু বিনোদনই নয়, বরং শিশুদের মানসিক বিকাশ ও সুস্থ প্রতিযোগিতার মূল্যবোধ তৈরি করার একটি সুন্দর পদক্ষেপ।</span></p>', NULL, NULL, NULL, 4, NULL, '2025-12-07', 8, NULL, NULL, 2, NULL, 1, NULL, NULL, NULL, '2025-12-07 02:07:18', '2026-04-06 17:00:45', NULL),
(3, 'Donate us', NULL, NULL, 'UyZXiy3XL9PlNeq', NULL, '<p><img src=\"data:image/png;base64,\"></p>', NULL, NULL, NULL, 1, NULL, '2025-12-09', NULL, NULL, NULL, NULL, NULL, 1, NULL, NULL, NULL, '2025-12-09 07:50:49', '2025-12-09 07:50:49', NULL),
(4, 'test', NULL, NULL, 'IGhQHG0MxhXLBEu', 'news/ighqhg0mxhxlbeu.jpg', '<p>test</p>', NULL, NULL, NULL, 1, NULL, '2025-12-09', 10, NULL, NULL, NULL, NULL, 1, NULL, NULL, NULL, '2025-12-09 08:16:16', '2026-03-26 23:38:59', NULL),
(5, 'tead', NULL, NULL, '4Djd0yzqolEqvT1', NULL, '<p>fsdfsa</p>', NULL, NULL, NULL, 1, NULL, '2025-12-09', NULL, NULL, NULL, NULL, NULL, 1, NULL, NULL, NULL, '2025-12-09 08:23:53', '2025-12-09 08:23:53', NULL),
(6, 'test', NULL, NULL, 'w6MmT8GHuTVZJyN', 'news/w6mmt8ghutvzjyn.jpg', '<p><span style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">আলহামদুলিল্লাহড্রিম হোমসের শিক্ষার্থীরা প্রতিকূলতাকে পেছনে ফেলে আলোর পথে এগিয়ে চলেছে। এখানে প্রত্যেকটি শিশু শুধু আশ্রয়ই নয়, পায় সঠিক দিকনির্দেশনা, মানসম্মত শিক্ষা এবং আত্মবিশ্বাস গড়ে তোলার সুযোগ। নানা সামাজিক চ্যালেঞ্জ সত্ত্বেও তারা নিজেদের স্বপ্ন ধরে রাখছে এবং প্রতিদিনই নতুন সাফল্যের গল্প লিখছ</span></p>', NULL, NULL, NULL, 4, NULL, '2025-12-13', 37, NULL, NULL, 1, 1, 1, NULL, NULL, NULL, '2025-12-13 03:44:44', '2026-05-03 07:10:37', NULL),
(7, 'test 02', NULL, NULL, 'lThjEQZG8wETohk', 'news/lthjeqzg8wetohk.png', '<p>ঘটনার সিসিটিভি ক্যামেরা ফুটেজ বিশ্লেষণ করে ওই ব্যক্তিকে শনাক্ত করা হয়েছে বলে পুলিশ জানিয়েছে। তাঁর ব্যাপারে তথ্য দিতে সবাইকে অনুরোধ জানিয়েছে ডিএমপি। আজ শনিবার ঢাকা মেট্রোপলিটন পুলিশ (ডিএমপি) সংবাদ বিজ্ঞপ্তিতে এ খবর জানিয়েছে।</p><p><br></p><p>ওসমান হাদির ওপর হামলাকারীদের খুঁজতে পুলিশ অভিযান চালাচ্ছে বলে ওই বিজ্ঞপ্তিতে জানানো হয়। শনাক্ত ব্যক্তির সম্পর্কে কোনো তথ্য থাকলে পুলিশকে জানাতে অনুরোধ জানানো হয়েছে।</p>', NULL, NULL, NULL, 4, NULL, '2025-12-13', 22, NULL, NULL, 2, 1, 1, NULL, NULL, NULL, '2025-12-13 03:47:20', '2026-04-22 22:12:04', NULL);

