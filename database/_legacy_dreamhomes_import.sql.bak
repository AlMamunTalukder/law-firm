(2, 'কলেজ ড্রীম হোমস', 'klej-dreem-homs', NULL, 'বাড়ি- ২২, রোড- ০৩, সেক্টর- ০৬, উত্তরা, ঢাকা- ১২৩০', NULL, 1, 2, '2025-12-07 02:22:37', '2026-02-09 22:08:25', NULL),
(3, 'চট্টগ্রাম', 'cttgram', NULL, '<iframe src=\"https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d227236.3570514981!2d91.819037!3d22.357395!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30acd8a64095dfd3%3A0x5015cc5bcb6905d9!2sChattogram!5e1!3m2!1sen!2sbd!4v1765609989518!5m2!1sen!2sbd\" width=\"600\" height=\"450\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>', NULL, 1, 3, '2025-12-13 01:12:19', '2026-01-05 06:09:46', '2026-01-05 06:09:46'),
(4, 'চট্টগ্রাম ড্রীম হোমস', 'cttgram-dreem-homs', NULL, 'আশরাফ আলী বিল্ডিং, শমসেরপাড়া, চানমিয়া সরকারি প্রাথমিক বিদ্যালয় এর উত্তর পার্শ্বে, চান্দগাও, চট্টগ্রাম', NULL, 1, 6, '2026-01-05 06:09:37', '2026-02-09 22:15:00', NULL),
(5, 'ওয়ামী ড্রীম হোমস', 'wamee-dreem-homs', NULL, 'ওয়ামী মসজিদ, সফিপুর, কালিয়াকৈর, গাজীপুর', NULL, 1, 4, '2026-02-09 22:10:47', '2026-02-09 22:10:47', NULL),
(6, 'যশোর ড্রীম হোমস', 'zsor-dreem-heams', NULL, 'এডাস আভা ইন্টারন্যাশনাল একাডেমি, রুপদিয়া, রুদ্রপুর, চাঁচড়া সদর, যশোর', NULL, 1, 5, '2026-02-09 22:12:15', '2026-02-09 22:12:15', NULL),
(7, 'ফিমেল ড্রীম হোমস', 'fimel-dreem-homs', NULL, '১ নং শ্যামলি হাউজিং, রোড- ৫/এ, সেক্টর- ৫, উত্তরা, ঢাকা- ১২৩০', NULL, 1, 3, '2026-02-09 22:14:26', '2026-02-09 22:14:26', NULL),
(8, 'সুনামগঞ্জ ড্রীম হোমস', 'sunamgnj-dreem-homs', NULL, 'সাচায়ানী, নন্দীর গাঁও, জগন্নাথপুর, সুনামগঞ্জ', NULL, 1, 7, '2026-02-09 22:16:36', '2026-02-09 22:16:36', NULL),
