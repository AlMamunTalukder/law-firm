--
-- Table structure for table `albums`
--

CREATE TABLE `albums` (
  `id` bigint(20) UNSIGNED NOT NULL,
  `name` text DEFAULT NULL,
  `photo` varchar(255) DEFAULT NULL COMMENT 'for video use as thumnail',
  `link` text DEFAULT NULL COMMENT 'basic used for video; for image external link',
  `type` tinyint(4) DEFAULT NULL COMMENT '1=image;2=video',
  `is_show_in_home` tinyint(1) DEFAULT NULL COMMENT '1=show in home page according to order',
  `is_home_slider_sticky` tinyint(1) DEFAULT NULL,
  `is_featured` tinyint(1) DEFAULT NULL COMMENT '1=show in category page slider for image or fatured video',
  `video_type` tinyint(4) DEFAULT NULL COMMENT '1=youtube;2=dailymotion;3=uploaded',
  `total_view` int(11) DEFAULT 0,
  `order` int(11) DEFAULT NULL,
  `status` tinyint(1) DEFAULT 1 COMMENT 'null=inactive;1=active',
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

