(19, 'সাহিত্য', '#', 1, '2024-09-25 04:29:04', '2024-09-25 04:29:04'),
(20, '<p><strong>মাওলানা আবুল বাসার নোমানী</strong></p><p><strong>প্রতিষ্ঠাতা :</strong> আল মাসজিদ ফাউন্ডেশন বাংলাদেশ</p><p>প্রকাশক কর্তৃক ক-২৪৪ প্রগতি সরণি, কুড়িল (বিশ্বরোড), বারিধারা, ঢাকা-১২২৯ থেকে প্রকাশিত এবং যমুনা প্রিন্টিং এন্ড পাবলিশিং লিঃ থেকে মুদ্রিত।</p><p>পিএবিএক্স : ৯৮২৪০৫৪-৬১, রিপোর্টিং : ৯৮২৩০৭৩, বিজ্ঞাপন : ৯৮২৪০৬২, ফ্যাক্স : ৯৮২৪০৬৩, সার্কুলেশন : ৯৮২৪০৭২। ফ্যাক্স : ৯৮২৪০৬৬</p><p>Email: companyname@gmail.com</p><p>স্বত্ব © অধিকার সংরক্ষিত</p><p></p><p></p><p></p><p></p>', NULL, 2, '2024-09-25 04:31:11', '2024-09-25 04:31:11'),
(17, '<h5 class=\"ql-align-right\"><span class=\"ql-size-large\">Address</span></h5><p class=\"ql-align-right\">House No. 17, Road No. 5, Sector No. 7, Uttara Model Town, Dhaka-1230</p><p><br></p>', NULL, 2, '2025-12-07 01:21:12', '2025-12-07 01:21:12'),
(16, '<p><span style=\"color: rgb(51, 51, 51); background-color: rgb(11, 82, 164);\"><img src=\"https://banglabulletin.com/dream-homes/assets/img/icons/logo-transparent.png\" style=\"margin: 0px 0px 10px; padding: 0px; box-sizing: border-box; width: 80px; max-width: 80px;\"></span></p><h5>Hotline: 01986330128</h5><h5>Mobile:  01986330128</h5><h5>Email: dreamhomesuttara@gmail.com</h5><p><br></p>', NULL, 2, '2026-03-31 10:23:08', '2026-03-31 10:23:08');

