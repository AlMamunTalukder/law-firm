(1, 'Engr. md. arifur rahman', NULL, 0, 'Engr.-md.-arifur-rahman', '01758444444', 'softwareindustry2008@gmail.com', '<p><span style=\"color: rgb(18, 18, 18);\">যুক্তরাজ্যের দুই স্বনামধন্য মানবাধিকার ও নীতি গবেষণাপ্রতিষ্ঠান রানিমিড ট্রাস্ট এবং রিপ্রিভ গত বৃহস্পতিবার এ গবেষণা প্রতিবেদন প্রকাশ করেছে। প্রতিবেদনে বলা হয়েছে, যুক্তরাজ্যে প্রায় ৯ মিলিয়ন (৯০ লাখ) মানুষ, অর্থাৎ মোট জনসংখ্যার প্রায় ১৩ শতাংশ দেশটির স্বরাষ্ট্রমন্ত্রীর ক্ষমতায় আইনগতভাবেই নাগরিকত্ব হারাতে পারেন</span></p>', NULL, 'https://www.facebook.com/engineer.arifur.rahman/', 'https://www.facebook.com/engineer.arifur.rahman/', 'https://www.facebook.com/engineer.arifur.rahman/', '1984-09-13', NULL, 'member/engr-md-arifur-rahman.jpg', 1, '2025-12-13 00:49:09', '2025-12-13 00:49:09', NULL);

